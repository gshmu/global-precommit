#!/bin/bash

# --- 1. 保留原有的 Git LFS 逻辑 ---
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path..."; exit 2; }
git lfs post-checkout "$@"

# --- 2. 自动安装 Hooks ---

# 仅在分支切换或首次检出时运行
[[ "$3" != "1" ]] && exit 0

# 配置文件不存在则跳过
[[ ! -f ".pre-commit-config.yaml" ]] && exit 0

# 定义查找顺序
BIN_ORDER=(
    "./.venv/bin/prek"
    "./.venv/bin/pre-commit"
    "$(command -v prek)"
    "$(command -v pre-commit)"
)

for CMD in "${BIN_ORDER[@]}"; do
    if [[ -x "$CMD" ]]; then
        echo -e "\n\e[32m󰄬\e[0m 检测到 $CMD，正在同步 Hooks..."
        
        # 只做最基础的 install
        # pre-commit 会自行处理 .pre-commit-config.yaml 里的类型
        "$CMD" install
        
        exit 0
    fi
done
